PORT=4000

# ─── MongoDB ───
# Native dev (mongo running on host):
# MONGODB_URI=mongodb://stockadmin:changeme@localhost:27017/test?authSource=admin
#
# Docker Compose (backend service → mongo service):
MONGODB_URI=mongodb://stockadmin:changeme@mongo:27017/test?authSource=admin&replicaSet=rs0

JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# NOTE: Transactional Email (ZeptoMail) and Payment Gateway (Razorpay) credentials
# are securely stored in the MongoDB database via SystemSetting (Admin Settings).
# No API keys need to be committed or stored in .env!
